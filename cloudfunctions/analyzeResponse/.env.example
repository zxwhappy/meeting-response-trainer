# 复制这些变量名到微信云开发控制台的云函数环境变量中。
# 不要把真实密钥写回本文件或 miniprogram 目录。
APP_MODE=production
USER_HASH_SALT=replace-with-at-least-16-random-characters

TC_SECRET_ID=replace-me
TC_SECRET_KEY=replace-me
TC_ASR_REGION=ap-shanghai
TC_ASR_ENGINE_TYPE=16k_zh
TC_ASR_ENDPOINT=asr.tencentcloudapi.com
TC_ASR_TIMEOUT_SECONDS=10

# OpenAI 兼容接口示例：DeepSeek 可使用 https://api.deepseek.com/v1
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=replace-me
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=12000
AI_JSON_MODE=true
